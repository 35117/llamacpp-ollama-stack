    capabilities:
      context: 16384

  # ----------------------------------------------------- 本地小模型 / Agent 层
  # LFM3 1.7B（Liquid AI，2026-10-27）：24 层 tri-hybrid —— 13 层门控短卷积 +
  #   5 层滑窗注意力（窗口 256）+ 6 层全局注意力。
  #   定位不是「懂很多」，而是「会调度」：BFCL V4 71.39 / ToolSandbox 80.36
  #   在同级里领先，IFEval 96.66 适合结构化输出与 JSON。但 HLE 只有 7.17，
  #   **不能当知识库**，问世界的答案要转给 qwen35-9b-heretic。
  #
  # ⚠ 上下文给 64K，不给官方的 256K：显存上 128K 也放得下（1.78 GiB），
  #   但这模型 RULER 128K 只有 65.56 —— 「塞得进去、捞不准」，虚设没意义。
  #   实测占用（python scripts\vram_budget.py models\LFM3-1.7B-Heretic-Abliterated-i1-Q4_K_M.gguf）：
  #   权重 1.02 GiB，32K KV 0.19、64K KV 0.38、128K KV 0.75（均 q8_0）。
  #   KV 这么省是因为混合注意力：SWA 那 5 层占用恒定，不随 ctx 增长。
  #
  # ⚠ 需要较新的 llama.cpp：'lfm3' 是新增架构，本部署 b11146 直接报
  #   `unknown model architecture: 'lfm3'`，升到 b12020 后才加载成功。
  #   换回旧构建的话这一段会启动失败，记得连着 bin/ 一起看。
  #
  # 权重用 Vortecks 的 heretic+abliterated（i1 = imatrix 量化），不是官方原版：
  #   2026-11-03 同参数实测 —— 工具调用 76 tokens（原版 92）、JSON 抽取 36 tokens
  #   逐字一致、生成速度 139.7 → 约 160 t/s。没有能力退化。
  #   但要说清楚：原版 1.7B 的 refusal 本来就很弱（粗口吐槽请求它照样照做），
  #   所以「去审查」在这里的收益≈0，换它的真实理由是 imatrix 量化更快。
  "lfm3-1.7b":
    name: "LFM3 1.7B Heretic"
    description: "本地 Agent 调度层 · 工具调用/JSON 结构化输出 · 社区去审查版 · 无世界知识"
    cmd: |
      {{ROOT}}/bin/llama-server.exe
      --host 127.0.0.1 --port ${PORT}
      -m {{ROOT}}/models/LFM3-1.7B-Heretic-Abliterated-i1-Q4_K_M.gguf
      -ngl 99 -c 65536 -fa on -ctk q8_0 -ctv q8_0
      -np 1 -b 2048 -ub 512
      --jinja --reasoning-format deepseek --metrics
    aliases:
      - "lfm3-1.7b:latest"
    capabilities:
      in: [text]
      tools: true
      context: 65536

  # ------------------------------------------------------ 全模态 / 看 + 听
  # LFM3-Omni-2B（abliter8-ai 去审查版）：2.17B = 1.7B 语言主干 + 视觉编码器 +
  #   16kHz 因果音频编码器 + LiquidCodec/depthformer（24kHz 语音输出）。
  #   去审查只改语言主干的 32 个残差写入矩阵，视觉/音频编码器原样保留 ——
  #   实测改完图像与音频识别都正常。
  #
  # ⚠ **llama.cpp 下只有输入侧完整**：图像、音频、视频帧都能进
  #   （b12020 的 mtmd 实测 --image 896ms / --audio 215ms 都通）；
  #   但没有 TTS 输出通路 —— 语音合成那半是 depthformer + LiquidCodec，
  #   llama.cpp 不实现。也就是：能听能看，不会说。
  #
  # ⚠ non-reasoning 模型：**不要**加 --reasoning-format deepseek，
  #   它每次回答都以空 <think></think> 开头。反过来好处是工具调用极省 token
  #   （实测 19 tokens，1.7B 要 76–92）。
  #
  # 显存：权重 1.02 + mmproj 0.95 + 32K KV 0.19 ≈ 2.2 GiB，8G 卡余量充足。
  #   ctx 取官方上限 32K（再大也不支持）。
  "lfm3-omni-2b":
    name: "LFM3 Omni 2B Abliter8"
    description: "全模态去审查版 · 看图/听音频/视频帧 + 工具调用 · 不能合成语音"
    cmd: |
      {{ROOT}}/bin/llama-server.exe
      --host 127.0.0.1 --port ${PORT}
      -m {{ROOT}}/models/LFM3-Omni-2B-Abliter8-Q4_K_M.gguf
      -mm {{ROOT}}/models/mmproj-LFM3-Omni-2B-Abliter8-BF16.gguf
      -ngl 99 -c 32768 -fa on -ctk q8_0 -ctv q8_0
      -np 1 -b 2048 -ub 512
      --jinja --metrics
    aliases:
      - "lfm3-omni:latest"
    capabilities:
      in: [text, image, audio]
      tools: true
      context: 32768

